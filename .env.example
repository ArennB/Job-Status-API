DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_status_db
# Copy this file to .env. Compose reads it automatically.
# Required for Compose; replace this development-only password before use.
POSTGRES_DB=job_status_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Optional host ports (container ports stay 8000 and 5432).
API_PORT=8000
POSTGRES_PORT=5432

# For running Python locally: export these variables with the credentials above.
# Compose explicitly sets DB_HOST=db and DB_PORT=5432 for the API.
DB_HOST=localhost
DB_PORT=5432

# Optional full URL override for local Python (takes precedence over DB_* and
# POSTGRES_*). URL-encode special characters in credentials when using a URL.
# Compose uses the separate credentials above, not this override.
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/job_status_db
